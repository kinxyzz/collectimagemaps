<section class="hero-section">
  <div class="hero-inner">
    <h1>Extract foto dari<br>Google Maps</h1>
    <p class="hero-sub">Masukkan nama tempat atau Toko. Foto resolusi tinggi akan dikumpulkan otomatis.</p>

    {{#error}}
    <div class="alert alert-error" role="alert">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      {{ error }}
    </div>
    {{/error}}

    <form class="search-form" method="POST" action="/scrape" id="scrapeForm">
      <div class="form-group">
        <label for="query">Nama tempat / Toko</label>
        <input
          type="text"
          id="query"
          name="query"
          placeholder="cth: Borobudur Temple, Kopi Kenangan Jakarta"
          value="{{ queryValue }}"
          required
          autocomplete="off"
        />
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="scrollRounds">Scroll rounds</label>
          <input type="number" id="scrollRounds" name="scrollRounds" value="25" min="5" max="100" />
          <span class="form-hint">Lebih banyak = lebih banyak foto</span>
        </div>
        <div class="form-group">
          <label for="headless">Mode browser</label>
          <select id="headless" name="headless">
            <option value="true">Headless (background)</option>
            <option value="false">Visible (tampilkan browser)</option>
          </select>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        Mulai Proses
      </button>
    </form>

    <div class="loading-state" id="loadingState" style="display:none;">
      <div class="spinner"></div>
      <p>Sedang Collecting Data... ini bisa memakan 1–3 menit.</p>
    </div>
  </div>
</section>

<script>
  document.getElementById('scrapeForm').addEventListener('submit', function() {
    document.getElementById('submitBtn').disabled = true;
    document.getElementById('submitBtn').textContent = 'Collecting...';
    document.getElementById('loadingState').style.display = 'flex';
  });
</script>
