<!DOCTYPE html>
<html lang="id" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title }}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="app-header">
    <div class="header-inner">
      <a href="/" class="logo" aria-label="Maps Photo Collector">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect x="3" y="3" width="22" height="22" rx="5" stroke="currentColor" stroke-width="2"/>
          <circle cx="10" cy="11" r="3" stroke="currentColor" stroke-width="1.8"/>
          <path d="M10 14c-3 0-5 1.5-5 3v1h10v-1c0-1.5-2-3-5-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
          <path d="M17 9h5M17 13h3M17 17h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
        <span>Maps Extractor</span>
      </a>
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle dark mode">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </div>
  </header>
  <main class="main-content">
    {{{ body }}}
  </main>
  <script>
    (function(){
      const t = document.querySelector('[data-theme-toggle]');
      const r = document.documentElement;
      let d = r.getAttribute('data-theme') || 'dark';
      function setTheme(theme) {
        d = theme;
        r.setAttribute('data-theme', d);
        if (t) t.innerHTML = d === 'dark'
          ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>'
          : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
      }
      setTheme(d);
      t && t.addEventListener('click', () => setTheme(d === 'dark' ? 'light' : 'dark'));
    })();
  </script>
</body>
</html>
